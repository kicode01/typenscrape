# Firebase (Project settings -> Your apps -> SDK setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Recipe generation. Groq (Llama 3) is tried first for latency; Gemini is the
# fallback. At least one of the two is required for generation to work.
VITE_GROQ_API_KEY=
VITE_GEMINI_API_KEY=

# Structured recipe lookup
VITE_SPOONACULAR_API_KEY=
